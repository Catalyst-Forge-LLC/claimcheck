{
	"name": "getclaimcheck",
	"version": "0.1.1",
	"private": false,
	"type": "module",
	"description": "Find what a claim leaves out. An agent with the skill writes a seven-dimension literacy report on a claim that rests on numbers; the source is left unchanged.",
	"license": "MIT",
	"author": "Catalyst Forge LLC",
	"keywords": [
		"skill",
		"review",
		"claims",
		"literacy",
		"fact-check",
		"llm",
		"agents"
	],
	"homepage": "https://claimcheck.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Catalyst-Forge-LLC/claimcheck.git"
	},
	"bugs": {
		"url": "https://github.com/Catalyst-Forge-LLC/claimcheck/issues"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./skills/*": "./skills/*",
		"./package.json": "./package.json"
	},
	"files": [
		"dist/index.js",
		"dist/index.d.ts",
		"skills",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc",
		"test": "tsc && node --test dist/index.test.js",
		"prepare": "tsc",
		"prepublishOnly": "tsc && pnpm test",
		"runs:prepare": "tsc && node dist/agreement.js prepare",
		"runs:collect": "tsc && node dist/agreement.js collect",
		"runs:table": "tsc && node dist/agreement.js table",
		"ship": "pnpm site:install && pnpm --dir site run ship",
		"site:install": "pnpm --dir site install --frozen-lockfile",
		"site:dev": "pnpm site:install && pnpm --dir site dev",
		"site:build": "pnpm site:install && pnpm --dir site run build",
		"site:deploy": "pnpm site:install && pnpm --dir site run ship"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@10.30.1",
	"devDependencies": {
		"@types/node": "^24.3.0",
		"typescript": "^5.9.2"
	}
}
